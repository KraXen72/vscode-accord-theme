	"semanticHighlighting": true,
	// Semantic token colors override TextMate scopes when a language server provides
	// semantic token information (e.g. TypeScript, Python with Pylance, Rust-analyzer, etc.).
	// The TextMate tokenColors below remain as fallback for languages without a semantic
	// token provider, or for tokens that the provider does not emit.
	//
	// Color palette used here (same as TextMate rules below):
	//   classes               → #FFFFB6  (soft yellow)
	//   built-in/stdlib class → #C6C5FE  (lavender, e.g. str/int in Python)
	//   types / interfaces
	//     / structs / enums   → #4EC9B0  (teal / green)
	//   functions / methods   → #96CBFE  (cornflower blue)
	//   variables / params
	//     / properties        → #FFFFFFD3 (near-white, default text)
	//   namespaces / modules  → #B5B3AA  (gray, like import keywords)
	//   enum members          → #E9C062  (gold / amber)
	//   decorators            → #E9C062  (gold / amber)
	"semanticTokenColors": {
		// ── Classes ────────────────────────────────────────────────────────
		// Identifiers that declare or reference a class type (Python, JS/TS,
		// Java, C#, …).  Kept yellow to distinguish from structural types.
		"class": "#FFFFB6",
		// Built-in / standard-library classes (e.g. str, int, bool, list in
		// Python; Array, Promise in TS) get the lavender primitive-type color
		// so they read closer to type annotations than to user-defined classes.
		// Pylance marks Python primitives as class.defaultLibrary.
		"class.defaultLibrary": "#C6C5FE",

		// ── Namespaces / modules ───────────────────────────────────────────
		// Module/namespace identifiers (e.g. `np` in np.array, imported
		// package names) use the same gray as import keywords so they don't
		// compete visually with class names.
		"namespace": "#FFFFFFD3",

		// ── Structural / nominal types ─────────────────────────────────────
		// Interfaces, structs, enums and generic type aliases all get the
		// teal "type" color so they read as "shape definitions", not classes.
		"interface": "#4EC9B0",
		"struct":    "#4EC9B0",
		"enum":      "#4EC9B0",
		"type":      "#4EC9B0",
		// Type parameters (T, K, V …) follow the same teal family.
		"typeParameter": "#4EC9B0",

		// ── Functions & methods ────────────────────────────────────────────
		"function": "#96CBFE",
		"method":   "#96CBFE",
		// Macros (Rust, C/C++) use the same function blue.
		"macro":    "#96CBFE",

		// ── Variables & parameters ─────────────────────────────────────────
		// Both mutable and readonly variables stay at the default text color;
		// they are not highlighted specially beyond what the editor provides.
		"variable":          "#FFFFFFD3",
		"variable.readonly": "#FFFFFFD3",
		"parameter":         "#FFFFFFD3",

		// ── Properties ────────────────────────────────────────────────────
		// Class instance properties / member fields use the same near-white
		// as regular variables so they don't stand out from normal identifiers.
		// (e.g. `query`, `searchResults` in Angular components, `self.x` in Python)
		"property":          "#FFFFFFD3",
		"property.readonly": "#FFFFFFD3",

		// ── Enum members ──────────────────────────────────────────────────
		// Enum variants / constants use gold, consistent with the constants
		// rule in tokenColors below.
		"enumMember": "#E9C062",

		// ── Decorators / annotations ──────────────────────────────────────
		// @decorators (Python, TS) and Java annotations share the gold color
		// used by the decorator TextMate rule below.
		"decorator": "#E9C062"
	},
